# Convention: <normalized_task_id>_conda_env=<conda_environment_name>
#
# Characters that are not valid in bash variable names are replaced by "_".
# For example, task "task-conda" looks up "task_conda_conda_env".
#
# If the environment does not exist, it is created from:
#   conda-envs/<environment_name>_environment.yml
#
# Example:
# task_align_conda_env=align-env
