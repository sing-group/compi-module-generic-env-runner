# Docker image per task: <normalized_task_id>_image=<docker_image>
#
# Example:
# task_align_image=pegi3s/clustalomega:latest
#
# Shell used inside the container for a task (default: /bin/bash):
# <normalized_task_id>_shell=<shell>
#
# Example:
# task_align_shell=/bin/sh
#
# Any variable named docker_mount_<name>=<path> is passed to docker run as:
#   -v <absolute_path>:<absolute_path>
#
# Relative paths are resolved against the directory containing runners.xml.
# Pipeline parameters can be used in the values. For example:
# docker_mount_work="${workingDir:-}"
#
# Example:
# docker_mount_data=./data
